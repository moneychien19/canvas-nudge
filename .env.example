# Copy to .env for local `dotnet run`. .env is gitignored — never commit real values.

# --- Secrets (required) ---
# Canvas personal access token (created with 120-day expiry). Acts as full account.
CANVAS_API_TOKEN=
# Discord channel incoming-webhook URL. Sensitive: anyone with it can post.
DISCORD_WEBHOOK_URL=

# --- Config (optional; defaults shown) ---
# Canvas instance base URL. Verify against your logged-in Canvas URL.
CANVAS_BASE_URL=https://canvas.cmu.edu
# IANA timezone for rendering due dates + digest timestamp.
TIMEZONE=America/New_York
# true (default) = always send a celebratory line when nothing is outstanding
# (also a liveness ping + carries any PAT-expiry warning); false = silent on empty.
NOTIFY_WHEN_EMPTY=true
# true (default) = on failure, also POST a short error line to Discord.
NOTIFY_ERRORS_TO_DISCORD=true
# Optional YYYY-MM-DD the current PAT expires. When set, digest warns <=14 days out.
CANVAS_TOKEN_EXPIRES_AT=
# Notification language: en (default) or zh-Hant (Traditional Chinese).
LANGUAGE=en
