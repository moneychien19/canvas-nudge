<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CanvasNudge</RootNamespace>
    <!-- Do NOT enable InvariantGlobalization: breaks TimeZoneInfo IANA + zh-Hant. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanvasNudge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-only: loads a local .env for `dotnet run`. No-op in CI (no .env present). -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>

</Project>
